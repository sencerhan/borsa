APP_NAME="BitKuruş Borsa"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=tr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Reverb (canlı order book / trade / cüzdan yayını için WebSocket) ---
# Kendi kurulumun için benzersiz değerler üret: php artisan reverb:install
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=9080
REVERB_SERVER_PORT=9080
REVERB_SCHEME=http
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# --- BitKuruş (BK$) zinciri — yatırma doğrulama + çekim imzalama (Ed25519) ---
BITKURUS_API_URL=https://bitkurush.org
BITKURUS_ACTIVITY_LIMIT=50

# --- Tron / TronGrid — USDT (TRC20) yatırma doğrulama + çekim ---
TRONGRID_API_URL=https://api.trongrid.io
# Ücretsiz API anahtarı: https://www.trongrid.io (rate-limit ve broadcast için gerekli)
TRONGRID_API_KEY=
TRONGRID_LIMIT=50
# Ana ağ USDT (TRC20) sözleşmesi
TRON_USDT_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
# secp256k1 imzalama için Node yardımcısı (scripts/tron-signer.cjs)
TRON_NODE_BIN=node
# TRC20 transferi için gas üst sınırı (SUN; 1 TRX = 1_000_000)
TRON_FEE_LIMIT=20000000
# Çekimlerin gönderildiği merkezi hot-wallet (USDT + TRX ile fonlanmalı).
# Anahtar Crypt::encryptString ile şifrelenmiş olmalı — asla düz metin private key koymayın.
TRON_HOT_WALLET_ADDRESS=
TRON_HOT_WALLET_KEY=
